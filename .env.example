# ChemicalOps 环境配置示例
# 复制为项目根目录的 .env 后，再填写本机数据库、密钥和服务地址。

# -----------------------------------------------------------------------------
# 应用基础配置
# -----------------------------------------------------------------------------
APP_NAME=ChemicalOps
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8888
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# 慢请求和慢 SQL 告警阈值；生产环境建议接入日志平台后按流量校准。
SLOW_REQUEST_MS=1000
DB_SLOW_QUERY_MS=500

# 前端地址；如果有多个来源，请使用英文逗号分隔。生产环境必须使用明确的 HTTPS 来源。
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# MySQL 8.0 及以上
# 数据库名称需要与 database/schema.sql 保持一致。
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=chemicalops
MYSQL_USER=chemicalops
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_CHARSET=utf8mb4

# SQLAlchemy 连接地址；FastAPI 请求路径优先使用异步地址。
DATABASE_URL=mysql+asyncmy://chemicalops:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/chemicalops?charset=utf8mb4
DATABASE_SYNC_URL=mysql+pymysql://chemicalops:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/chemicalops?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false
FILE_STORAGE_ROOT=storage
DOCUMENT_MAX_SIZE_MB=50
DOCUMENT_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,csv,txt,png,jpg,jpeg
# 是否启用上传前病毒扫描；生产环境启动门禁要求开启，并确保 clamdscan/ClamAV 服务可用。
FILE_SCAN_ENABLED=false
# 病毒扫描命令；程序会以安全的非 shell 方式调用，并通过标准输入传递文件内容。
FILE_SCAN_COMMAND=clamdscan
# 单个文件的病毒扫描超时时间（秒）。
FILE_SCAN_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Redis 主数据缓存、热点会话和用户级限流
# -----------------------------------------------------------------------------
# 默认关闭以兼容未启动 Redis 的环境；启动后将下面两项设为 true。
REDIS_ENABLED=false
REDIS_RATE_LIMIT_ENABLED=false
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_KEY_PREFIX=chemicalops
REDIS_TIMEOUT_SECONDS=0.3
REDIS_CACHE_TTL_SECONDS=300
REDIS_SESSION_TTL_SECONDS=60
AI_RATE_LIMIT_REQUESTS=30
DOCUMENT_RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# MinIO / S3 兼容对象存储
# 文件内容存储在对象存储中，MySQL 只保存元数据和对象键。
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_BUCKET=chemicalops-files
MINIO_DOCUMENT_BUCKET=chemicalops-documents
MINIO_RESULT_BUCKET=chemicalops-results
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PRESIGNED_URL_EXPIRES_SECONDS=900
FILE_STORAGE_BACKEND=local

# -----------------------------------------------------------------------------
# 身份认证与权限
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_SCHEME=pbkdf2_sha256
ADMIN_USERNAME=system_admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_DISPLAY_NAME=系统管理员
DEMO_DEFAULT_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# -----------------------------------------------------------------------------
# 大语言模型与智能体
# 使用 OpenAI 兼容协议，可接入 DeepSeek、自建网关或其他兼容服务。
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=65536
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MODEL_PROFILES_JSON=
LLM_DEFAULT_PROFILE=
LLM_MAX_CONCURRENCY=8
LLM_USER_MAX_CONCURRENCY=2
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=30
LLM_STREAM_USAGE=false

# 向量嵌入；MVP 关键词搜索阶段可以关闭。
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# 智能体安全默认值：业务写操作只能生成草稿，必须由用户确认。
AGENT_ENABLED=true
AGENT_ALLOW_WRITE_TOOLS=false
AGENT_MAX_STEPS=12
AGENT_TASK_TIMEOUT_SECONDS=120
AGENT_CONTEXT_MAX_CHARS=18000
# 预留：尚未实现独立同步 SQL 超时；任务超时配置见上方
AGENT_TOOL_TIMEOUT_SECONDS=30
# 预留日志开关不控制 ai_agent_tasks：任务会保存本人问题与公开工具结果
AGENT_SAVE_INPUT_CONTENT=false
AGENT_SAVE_OUTPUT_CONTENT=false

# -----------------------------------------------------------------------------
# 可选向量检索；MVP 阶段可以保持关闭。
# -----------------------------------------------------------------------------
VECTOR_STORE_ENABLED=false
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chemicalops_documents

# -----------------------------------------------------------------------------
# 文档解析与 OCR
# -----------------------------------------------------------------------------
DOCUMENT_PARSER_ENABLED=true
DOCUMENT_MAX_SIZE_MB=50
DOCUMENT_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,csv,txt
DOCUMENT_PARSE_TIMEOUT_SECONDS=300
OCR_ENABLED=false

# MinerU 文档解析服务；仅在上传的 PDF/Office 附件进入 AI 时调用，OCR 仍关闭。
MINERU_ENABLED=false
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=2
# MinerU 网络瞬时失败的最大重试次数；业务解析失败不会重复提交。
MINERU_MAX_RETRIES=2
# 解析状态持续为 PROCESSING 超过该秒数后，由调度器回收为 FAILED。
FILE_PARSE_STALE_AFTER_SECONDS=900

# -----------------------------------------------------------------------------
# 业务运行默认值
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY_CODE=CNY
DEFAULT_TIMEZONE=Asia/Shanghai
OVERDUE_SCAN_INTERVAL_SECONDS=900
QUALITY_PENDING_ALERT_HOURS=24
# 定时逾期/库存临期提醒默认关闭；完成内部验证并安排接收角色后再开启。
BUSINESS_ALERTS_SCHEDULER_ENABLED=false
# 生产环境必须设为 true；普通前端写请求会自动带键，登录与 AI SSE 路由豁免响应缓存。
IDEMPOTENCY_REQUIRED=false
REQUEST_NO_PREFIX=PR
RFQ_NO_PREFIX=RFQ
QUOTE_NO_PREFIX=Q
PO_NO_PREFIX=PO
DELIVERY_NO_PREFIX=DLV
ACCEPTANCE_NO_PREFIX=QA
EXCEPTION_NO_PREFIX=EX
COMPARISON_NO_PREFIX=QC

# -----------------------------------------------------------------------------
# 可观测性与外部集成
# -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
WEBHOOK_SIGNING_SECRET=CHANGE_ME_WEBHOOK_SECRET
# MySQL 持久任务队列（默认启用，开发入口自动启动两类 Worker）
TECHNICAL_DOCUMENT_EXECUTION_MODE=database
AGENT_EXECUTION_MODE=database
TASK_POLL_INTERVAL_SECONDS=1
TASK_MAX_ATTEMPTS=3
TASK_LEASE_SECONDS=60
TASK_HEARTBEAT_SECONDS=10
TASK_DOCUMENT_CONCURRENCY=1
TASK_AGENT_CONCURRENCY=1
