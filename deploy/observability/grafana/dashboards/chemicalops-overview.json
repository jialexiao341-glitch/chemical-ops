{
  "uid": "chemicalops-overview",
  "title": "ChemicalOps 后端运行概览",
  "tags": ["chemicalops", "backend"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "API 请求速率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "sum by (method, path) (rate(chemicalops_api_requests_count[5m]))", "legendFormat": "{{method}} {{path}}" }]
    },
    {
      "id": 2,
      "title": "API P95 延迟（秒）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(chemicalops_api_request_duration_seconds_histogram_bucket[5m])))", "legendFormat": "P95" }]
    },
    {
      "id": 3,
      "title": "任务队列积压",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "max by (queue) (chemicalops_task_queue_backlog)", "legendFormat": "{{queue}}" }]
    },
    {
      "id": 4,
      "title": "最老可执行任务等待（秒）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "max by (queue) (chemicalops_task_queue_oldest_ready_seconds)", "legendFormat": "{{queue}}" }]
    },
    {
      "id": 5,
      "title": "LLM Gateway P95 延迟（秒）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(chemicalops_llm_gateway_duration_seconds_histogram_bucket[5m])))", "legendFormat": "{{mode}}" }]
    },
    {
      "id": 6,
      "title": "Redis 缓存请求结果",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "sum by (space, result) (rate(chemicalops_redis_cache_count[5m]))", "legendFormat": "{{space}} / {{result}}" }]
    },
    {
      "id": 7,
      "title": "LLM 首 Token P95 延迟（秒）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, mode, provider) (rate(chemicalops_ai_first_token_seconds_histogram_bucket[5m])))", "legendFormat": "{{provider}} / {{mode}}" }]
    },
    {
      "id": 8,
      "title": "数据库连接池状态",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "chemicalops_database_pool_connections", "legendFormat": "{{instance}} / {{state}}" }]
    },
    {
      "id": 9,
      "title": "Agent 工具调用成功率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "sum by (tool) (rate(chemicalops_agent_tool_calls_count{result=\"succeeded\"}[5m])) / clamp_min(sum by (tool) (rate(chemicalops_agent_tool_calls_count[5m])), 1e-9)", "legendFormat": "{{tool}}" }]
    },
    {
      "id": 10,
      "title": "数据库查询速率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "sum by (operation) (rate(chemicalops_database_queries_count[5m]))", "legendFormat": "{{operation}}" }]
    },
    {
      "id": 11,
      "title": "Worker 任务执行耗时均值（15 分钟）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "max by (queue, status) (chemicalops_task_execution_duration_seconds)", "legendFormat": "{{queue}} / {{status}}" }]
    },
    {
      "id": 12,
      "title": "失败任务（待处置）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "max by (queue) (chemicalops_task_queue_executions{status=\"failed\"})", "legendFormat": "{{queue}}" }]
    },
    {
      "id": 13,
      "title": "需隔离核验任务",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "chemicalops-prometheus" },
      "targets": [{ "expr": "max by (queue) (chemicalops_task_queue_isolation_required)", "legendFormat": "{{queue}}" }]
    }
  ]
}
