    {
      "section": "产品标识",
      "text": "中文名：异噻唑啉酮",
      "source_row": 1,
      "source_cell": 2
    },
    {
      "section": "产品标识",
      "text": "英文名：5-chloro-2-methyl-4-isothiazolin-3-one1",
      "source_row": 1,
      "source_cell": 3
    },
    {
      "section": "分子信息",
      "text": "分子式：C4H4NSOCl和C4H4NSO",
      "source_row": 2,
      "source_cell": 2
    },
    {
      "section": "分子信息",
      "text": "分子量：150.0和115.0",
      "source_row": 2,
      "source_cell": 3
    },
    {
      "section": "外观与溶解性",
      "text": "性状：浅黄色或澄色透明液体。存品为白色固体，略有气味。",
      "source_row": 4,
      "source_cell": 2
    },
    {
      "section": "外观与溶解性",
      "text": "溶解性：溶于乙醇、乙二醇等低级醇，浅琥珀色，气味温和。",
      "source_row": 5,
      "source_cell": 2
    },
    {
      "section": "理化性质",
      "text": "熔点（℃）：48～50",
      "source_row": 6,
      "source_cell": 2
    },
    {
      "section": "理化性质",
      "text": "相对密度（水＝1）：1.02",
      "source_row": 6,
      "source_cell": 4
    },
    {
      "section": "理化性质",
      "text": "饱和蒸汽压（kPa）：0.16(20℃)",
      "source_row": 8,
      "source_cell": 4
    },
    {
      "section": "储存与包装信息",
      "text": "包装标志：     UN编号：      包装分类：\n包装方法：采用塑料桶包装。\n储运条件：储存于阴凉、通风的仓库内，不可与还原性金属接触，避免导致产品分解。",
      "source_row": 21,
      "source_cell": 2
    }
